{
  "name": "smartsheet-to-microsoft-ppm",
  "private": true,
  "version": "1.0.0",
  "description": "Smartsheet to Microsoft: IT project & portfolio management as a Power Apps code app on Dataverse, with Teams, Power Automate and Power BI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:dataverse": "vite --mode dataverse",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "npm run typecheck && vite build --mode dataverse",
    "build:demo": "npm run typecheck && vite build",
    "build:live": "node scripts/build-live.mjs",
    "preview": "vite preview",
    "test": "tsx scripts/smoke-test.ts",
    "test:render": "tsx scripts/render-test.tsx",
    "check": "npm run typecheck && npm test && npm run test:render",
    "dataverse:plan": "tsx dataverse/provision.ts --plan",
    "dataverse:provision": "tsx dataverse/provision.ts",
    "dataverse:verify": "tsx scripts/verify-dataverse.ts",
    "pac:add-sources": "tsx scripts/pac-add-sources.ts",
    "teams:package": "tsx teams/build.ts",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@microsoft/power-apps": "1.5.0",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@microsoft/power-apps-vite": "1.0.13",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "puppeteer-core": "25.15.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
